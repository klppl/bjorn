{{!< default}}

{{#post}}

<article class="{{post_class}}">

    <header class="post-header">
        <h1>{{title}}</h1>
        <p>
            <i>
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM, YYYY"}}</time> &bull; {{reading_time}}
            </i>
        </p>
    </header>

    {{#if feature_image}}
    <figure class="post-feature-image">
        <img
            srcset="{{img_url feature_image size="s"}} 300w,
                    {{img_url feature_image size="m"}} 600w,
                    {{img_url feature_image size="l"}} 1200w"
            sizes="(max-width: 720px) 100vw, 720px"
            src="{{img_url feature_image size="m"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
        />
        {{#if feature_image_caption}}
            <figcaption>{{feature_image_caption}}</figcaption>
        {{/if}}
    </figure>
    {{/if}}

    <div class="gh-content">
        {{content}}
    </div>

    {{#if tags}}
    <div class="tags-list">
        {{#foreach tags}}
            <a href="{{url}}">#{{name}}</a>
        {{/foreach}}
    </div>
    {{/if}}

    <nav class="post-navigator" aria-label="Post Navigation">
        <div class="post-nav-prev">
            {{#prev_post}}
                <a href="{{url}}">&laquo; {{title}}</a>
            {{/prev_post}}
        </div>
        <div class="post-nav-next">
            {{#next_post}}
                <a href="{{url}}">{{title}} &raquo;</a>
            {{/next_post}}
        </div>
    </nav>

    {{#if comments}}
    <section class="gh-comments">
        {{comments}}
    </section>
    {{/if}}

</article>

{{/post}}
